{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "oxinab-driver.vercel.app"
        }
      ],
      "destination": "/driver",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "oxinab-admin.vercel.app"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/driver",
      "has": [
        {
          "type": "host",
          "value": "oxinab.vercel.app"
        }
      ],
      "destination": "https://oxinab-driver.vercel.app/driver",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "oxinab.vercel.app"
        }
      ],
      "destination": "https://oxinab-admin.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/driver",
      "has": [
        {
          "type": "host",
          "value": "oxinab-catalog.vercel.app"
        }
      ],
      "destination": "https://oxinab-driver.vercel.app/driver",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "oxinab-catalog.vercel.app"
        }
      ],
      "destination": "https://oxinab-admin.vercel.app/admin",
      "permanent": false
    }
  ]
}